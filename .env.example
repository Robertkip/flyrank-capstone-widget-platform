# Copy to .env - never commit .env
PUBLIC_BASE_URL=http://localhost:8000
# Abuse protection
RATE_LIMIT_PER_IP=5
RATE_LIMIT_IP_WINDOW_SECONDS=10
RATE_LIMIT_PER_WIDGET=60
MAX_BODY_BYTES=10240
MIN_FILL_MS=1500
TRUST_X_FORWARDED_FOR=1          # demo only: lets curl simulate many visitors. Set 0 unless behind a proxy you control.
# Geo enrichment chain: deterministic mocks (default) or the real free APIs: GEO_CHAIN=ip-api,ipapi-co
GEO_CHAIN=mock_a,mock_b
GEO_TIMEOUT_SECONDS=2
# Side effect: log | smtp (Mailpit) | fail (forced failure)
EMAIL_MODE=log
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=widgets@example.test
ALERT_LOG=./data/alerts.log
# Dev toggles /dev/geo-providers and /dev/side-effects (for the probes). Set DEV_MODE=0 in production.
DEV_MODE=1
DEV_TOKEN=
# Without Docker the default is SQLite: DATABASE_URL=sqlite:///./data/widgets.db
